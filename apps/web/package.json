{
  "name": "@recruitment/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "npm run build -w @recruitment/domain && npm run build -w @recruitment/db",
    "predev": "npm run build:deps",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run build:deps",
    "build": "tsc -p tsconfig.json && vite build",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:deps",
    "test": "vitest run"
  },
  "dependencies": {
    "@recruitment/domain": "*",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.21.0",
    "vite": "^8.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
