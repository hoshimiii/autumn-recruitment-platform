# Backend
SPRING_DATASOURCE_URL=jdbc:sqlite:./data/recruitment.sqlite
RECRUITOPS_USER_AGENT=AutumnRecruitmentBot/1.0
RECRUITOPS_BIND_ADDRESS=127.0.0.1
RECRUITOPS_CONNECT_TIMEOUT_SECONDS=10
RECRUITOPS_MINIMUM_FLOOR_SECONDS=5
RECRUITOPS_DAILY_CRON="0 0 8 * * *"
RECRUITOPS_DAILY_TIMEZONE=Asia/Shanghai
RECRUITOPS_COLLECTOR_ALLOW_PRIVATE_ADDRESSES=false

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Optional provider secrets. Configure only the variable name in the UI, never its value.
# RECRUITOPS_AI_KEY=
# SUB2API_API_KEY=

# Optional derived middleware, disabled by default. See infra/README.md.
RECRUITOPS_REDIS_ENABLED=false
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=16379
RECRUITOPS_ELASTICSEARCH_ENABLED=false
RECRUITOPS_ELASTICSEARCH_URL=http://127.0.0.1:19200

# OIDC profile requires issuer/audience/client ID and an environment-only secret.
# SPRING_PROFILES_ACTIVE=oidc
# RECRUITOPS_OIDC_ISSUER=http://127.0.0.1:18180/realms/recruitops
# RECRUITOPS_OIDC_AUDIENCE=recruitops-api
# RECRUITOPS_OIDC_CLIENT_ID=recruitops-web
# RECRUITOPS_OIDC_CLIENT_SECRET=
# RECRUITOPS_OIDC_FRONTEND_URL=http://127.0.0.1:5173/

# Browser worker provider variables are process-only, independent of Java settings.
# SUB2API_BASE_URL=http://127.0.0.1:18080/v1
# SUB2API_TOKEN=
# SUB2API_MODEL=
# BROWSER_WORKER_TOKEN=
