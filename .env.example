# Backend
SPRING_DATASOURCE_URL=jdbc:sqlite:./data/recruitment.sqlite
RECRUITOPS_USER_AGENT=RecruitOps/1.0
RECRUITOPS_CONNECT_TIMEOUT_SECONDS=10
RECRUITOPS_MINIMUM_FLOOR_SECONDS=5
RECRUITOPS_DAILY_CRON="0 0 8 * * *"
RECRUITOPS_DAILY_TIMEZONE=Asia/Shanghai
RECRUITOPS_COLLECTOR_ALLOW_PRIVATE_ADDRESSES=false

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Optional provider secret. Configure a source with this variable name, never its value.
# RECRUITOPS_AI_KEY=
