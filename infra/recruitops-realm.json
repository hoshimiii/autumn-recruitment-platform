{
  "realm": "recruitops",
  "enabled": true,
  "roles": {"realm": [{"name":"VIEWER"},{"name":"COLLECTOR"},{"name":"REVIEWER"},{"name":"ADMIN"}]},
  "clients": [{
    "clientId": "recruitops-web",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": false,
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "redirectUris": ["http://127.0.0.1:8080/login/oauth2/code/recruitops"],
    "webOrigins": ["http://127.0.0.1:5173"],
