{
  "name": "autumn-recruitment-platform",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": ["apps/web"],
  "scripts": {
    "build": "npm run build -w @recruitment/web",
    "test": "npm run test -w @recruitment/web",
    "test:watch": "npm run test:watch -w @recruitment/web",
    "lint": "npm run typecheck -w @recruitment/web",
    "typecheck": "npm run typecheck -w @recruitment/web",
    "dev:server": ".\\mvnw.cmd -f apps/server/pom.xml spring-boot:run",
    "dev:web": "npm run dev -w apps/web",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
